{
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }],
  // Duplicated from tsconfig.app.json purely so tooling that reads the root
  // config can resolve `@/*` — the shadcn CLI is one, and without it, it writes
  // generated components into a literal `@/` directory.
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
